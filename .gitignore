## Ignore Visual Studio / .NET build artifacts

# Build outputs
[Bb]in/
[Oo]bj/
out/
publish/

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Rider / JetBrains
.idea/
*.sln.iml

# NuGet
*.nupkg
*.snupkg
packages/
!**/[Pp]ackages/build/
project.lock.json
project.fragment.lock.json
artifacts/

# Test results
TestResults/
*.trx
*.coverage

# Logs
*.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# ─── .NET MAUI specific ───────────────────────────────────────────────────────

# Android
**/android/assets/
**/android/bin/
**/android/obj/

# iOS
**/ios/obj/
*.ipa
*.dSYM.zip
*.dSYM

# macOS Catalyst
**/maccatalyst/obj/

# Windows
**/windows/obj/
AppPackages/
*.msix
*.msixbundle
*.appx
*.appxbundle

# MAUI intermediate files
**/.maui/
**/GeneratedFiles/

# Certificates / signing
*.pfx
*.p12
*.mobileprovision
*.cer
*_Signature.p7s

# Generated resource files
**/*Designer.cs
**/*.g.cs
**/*.g.i.cs

# Coverage
lcov.info
*.opencover.xml

# Temporary
*.tmp
*.temp
~$*
