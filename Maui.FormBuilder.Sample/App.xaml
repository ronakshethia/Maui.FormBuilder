<?xml version="1.0" encoding="UTF-8" ?>
<Application
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Maui.FormBuilder.Sample.App">

    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#6C63FF</Color>
            <Color x:Key="PrimaryDark">#5A52D5</Color>
            <Color x:Key="Secondary">#FF6584</Color>
            <Color x:Key="Background">#F8F9FA</Color>
            <Color x:Key="Surface">#FFFFFF</Color>
            <Color x:Key="TextPrimary">#1A1A2E</Color>
            <Color x:Key="TextSecondary">#6C757D</Color>

            <!-- Global button style -->
            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <!-- Global entry style -->
            <Style TargetType="Entry">
                <Setter Property="BackgroundColor" Value="White" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>

</Application>
